# Copie este archivo como .env (está en .gitignore) y complete los valores.
# backend/run.sh y docker compose lo leen. Nunca suba el .env al repositorio.

# Modelo: provisional (YASA) | api (modelo del proyecto en SageMaker) | mock (pruebas)
SOMNOAI_MODEL=api

# API pública del modelo del proyecto (la entrega quien administra el endpoint)
SOMNOAI_MODEL_API=https://<id>.lambda-url.us-east-1.on.aws
SOMNOAI_MODEL_TOKEN=<token personal; no lo comparta>
# Carpeta de S3 donde la API ya tiene las 32 noches de test (esas no se vuelven a subir)
SOMNOAI_MODEL_NIGHTS=s3://<bucket-del-modelo>/sistema-sueno/noches/
# Versión que sirve el endpoint (la API no la informa): tag del repositorio del modelo
SOMNOAI_MODEL_VERSION=sistema-sueno-v7
